@using AppASPNETCore.Data
@using Microsoft.AspNetCore.Identity
@* @inject : INJECTION DE DÉPENDANCES dans une vue.
   On demande à ASP.NET un UserManager<ApplicationUser> (l'outil d'Identity pour gérer les utilisateurs),
   disponible ensuite dans la vue sous le nom "UserManager". On s'en sert juste en dessous pour récupérer
   le prénom et le nom de l'utilisateur connecté.
   (Les deux lignes @using au-dessus permettent d'écrire ApplicationUser et UserManager sans leur nom complet.) *@
@inject UserManager<ApplicationUser> UserManager
@{
    // Texte affiché dans le menu après "Bonjour" quand l'utilisateur est connecté (voir plus bas dans le menu).
    string displayName = "";

    if (User.Identity?.IsAuthenticated == true) //Seulement si l'utilisateur est connecté
    {
        // On va chercher dans la base de données l'utilisateur actuellement connecté.
        // GetUserAsync lit l'Id de l'utilisateur dans son cookie de connexion (User), puis récupère
        // l'objet ApplicationUser correspondant dans la table AspNetUsers (avec son prénom et son nom).
        ApplicationUser? currentUser = await UserManager.GetUserAsync(User);

        // On assemble "Prénom Nom".
        // Trim() enlève les espaces au début et à la fin (utile si le prénom ou le nom est vide).
        displayName = $"{currentUser?.FirstName} {currentUser?.LastName}".Trim();

        // Si l'utilisateur n'a pas encore de prénom ni de nom (compte créé avant cette fonctionnalité),
        // on affiche son email à la place, pour ne pas afficher "Bonjour" tout seul.
        // string.IsNullOrEmpty vérifie si le texte est vide ; "?? """ remplace une valeur null par un texte vide.
        if (string.IsNullOrEmpty(displayName))
        {
            displayName = User.Identity.Name ?? "";
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppASPNETCore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppASPNETCore.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AppASPNETCore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @* User.Identity.IsAuthenticated vaut true si l'utilisateur est CONNECTÉ, false sinon.
                       (User est disponible dans toutes les vues : il est rempli grâce à app.UseAuthentication() dans Program.cs)
                       Le "?." et "== true" évitent une erreur si User.Identity vaut null. *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @* ===== Utilisateur CONNECTÉ : on affiche le menu de l'application ===== *@
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            @* Lien du menu vers la liste des étudiants : asp-controller="Students" + asp-action="Index" génèrent l'URL /Students *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Students" asp-action="Index">Étudiants</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        </ul>

                        @* Partie droite du menu : nom de l'utilisateur + bouton de déconnexion.
                           Les liens pointent vers les pages d'Identity UI (dossier Areas/Identity/Pages/Account) :
                           - asp-area="Identity" : la page se trouve dans l'Area "Identity" (le dossier Areas/Identity) ;
                           - asp-page="/Account/..." : le chemin de la page à l'intérieur de Areas/Identity/Pages.
                           (On utilise asp-page et pas asp-controller/asp-action car ce sont des Razor Pages, pas des vues MVC.) *@
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                @* On affiche "Bonjour Prénom Nom" (variable displayName calculée en haut de ce fichier).
                                   Le lien mène à la page "Gérer mon compte" d'Identity (modifier son prénom, son nom, son mot de passe...). *@
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index">Bonjour @displayName</a>
                            </li>
                            <li class="nav-item">
                                @* La déconnexion se fait avec un FORMULAIRE en POST (et pas un simple lien) pour des raisons de sécurité :
                                   sinon n'importe quel site pourrait déconnecter l'utilisateur en lui faisant charger l'adresse de déconnexion.
                                   asp-route-returnUrl : après la déconnexion, la page Logout redirige vers cette adresse (ici la page de connexion).
                                   "btn btn-link" donne au bouton l'apparence d'un lien. *@
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Déconnexion</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        @* ===== Utilisateur NON connecté : on affiche seulement les liens de connexion et d'inscription ===== *@
                        @* "ms-auto" (Bootstrap) pousse ces liens tout à droite du menu.
                           Les liens pointent vers les pages Login et Register d'Identity UI (voir l'explication de asp-area/asp-page plus haut). *@
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Inscription</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AppASPNETCore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
